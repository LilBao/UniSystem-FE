# ============================================================================
# UniSystem Frontend Environment Template
# Copy file này thành .env hoặc .env.local trước khi chạy:
#   Copy-Item .env.example .env
# ============================================================================

# URL của FastAPI Backend (dùng cho Next.js Rewrite Proxy trong next.config.ts để tránh lỗi CORS)
BACKEND_URL=http://127.0.0.1:8000

# Để trống để gọi qua Next.js Proxy (/api/v1/* -> BACKEND_URL/api/v1/*)
# Hoặc đặt trực tiếp (VD: http://127.0.0.1:8000) nếu Backend đã bật CORSMiddleware
NEXT_PUBLIC_API_URL=

# Timeout cho Axios request (ms) - Layer 1 OCR & Pipeline 2/3 chạy đồng bộ trong HTTP request
NEXT_PUBLIC_API_TIMEOUT_MS=120000

# ============================================================================
# Default Academic Seed UUIDs (Khớp với Backend/seed_local.sql)
# ============================================================================
NEXT_PUBLIC_DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
NEXT_PUBLIC_DEFAULT_COURSE_ID=00000000-0000-4000-8000-000000000002
NEXT_PUBLIC_DEFAULT_PROJECT_ID=00000000-0000-4000-8000-000000000003
NEXT_PUBLIC_DEFAULT_GROUP_ID=00000000-0000-4000-8000-000000000004
NEXT_PUBLIC_DEFAULT_RUBRIC_VERSION_ID=00000000-0000-4000-8000-000000000005

